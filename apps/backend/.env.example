# OpenCode Go Pool 后端环境变量示例。
# 复制为 .env 使用；.env 不入库。所有值均为占位符，无真实密钥。

APP_NAME=opencode-go-pool
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=48700
# B2 代理：上游默认地址（账号未配 base_url 时使用）
UPSTREAM_BASE_URL=https://api.opencode.ai/v1
UPSTREAM_TIMEOUT=60
# B3 账号轮换：冷却扫描间隔（秒）与连续失败自动禁用阈值
POOL_SCAN_INTERVAL_SECONDS=60
MAX_CONSECUTIVE_FAILURES=3
# B4 状态持久化：SQLite 路径（相对运行目录；可改绝对路径）
DB_PATH=data/opencode_pool.db
# C5 额度查询：缓存秒数与单账号上游超时（官方 /usage 接口）
QUOTA_CACHE_TTL_SECONDS=60
QUOTA_TIMEOUT_SECONDS=10
# G8 极致性能模式：true 时成功请求不落 SQLite，只做固定上限内存聚合
# （配合：失败/切换/冷却/禁用事件仍完整落库；重启后成功逐条历史不保留；
#  /api/stats 会返回 mode=fast 并在监控台标注口径）。默认 false 保持完整历史。
FAST_MODE=false
